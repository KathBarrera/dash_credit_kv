{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd dash && (test -f modelo/modelo_credito.pkl || python -m modelo.entrenar 12 || echo '[build] no se pudo entrenar el modelo')"
  },
  "deploy": {
    "startCommand": "gunicorn --chdir dash app:server --bind 0.0.0.0:$PORT --workers 2 --preload --timeout 120",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
